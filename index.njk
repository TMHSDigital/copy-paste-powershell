---
layout: base.njk
title: PowerShell for Dummies
description: PowerShell commands, scripts, and builders. Copy them. Run them.
---
<section class="hero">
  <div class="cover-lockup">
    <p class="cover-topic">PowerShell</p>
    <p class="cover-series">FOR DUMMIES</p>
  </div>
  <p class="lede">Commands to copy. Scripts to run. Builders that fill in the blanks. No memorizing required.</p>
  <form class="hero-search" role="search">
    <label class="visually-hidden" for="home-q">Search</label>
    <span class="prompt" aria-hidden="true">PS&gt;</span>
    <input id="home-q" type="search" placeholder="Get-ChildItem, CSV, ping" autocomplete="off" data-search-input>
  </form>
  <div id="search-results" class="search-results" hidden></div>
  <p class="hero-stats">
    <span><strong>{{ collections.commands.length }}</strong> commands</span>
    <span><strong>{{ collections.scripts.length }}</strong> scripts</span>
    <span><strong>{{ collections.builders.length }}</strong> builders</span>
    <span><strong>{{ collections.guides.length }}</strong> guides</span>
  </p>
</section>

<section>
  <div class="section-head">
    <p class="part-label">Part 1</p>
    <h2>Start here</h2>
    <p>Read these in order. Then skip around.</p>
  </div>
  <ol class="guide-steps">
    {% for item in collections.guides %}
      <li>
        <a href="{{ item.url }}">{{ item.data.title }}</a>
        <p>{{ item.data.summary }}</p>
      </li>
    {% endfor %}
  </ol>
</section>

<section>
  <div class="section-head">
    <p class="part-label">Part 2</p>
    <h2>The commands</h2>
    <p>Grouped the way you will actually look them up.</p>
  </div>
  <div class="card-grid">
    {% for cat in collections.commandCategories %}
      <a class="card card-stat" href="/commands/#{{ cat.slug }}">
        <p class="card-count">{{ cat.count }}</p>
        <h3>{{ cat.label }}</h3>
        <p>command{% if cat.count != 1 %}s{% endif %}</p>
      </a>
    {% endfor %}
  </div>
</section>

<section>
  <div class="section-head">
    <p class="part-label">Cheat sheet</p>
    <h2>Six to steal first</h2>
    <p>These cover most of week one.</p>
  </div>
  <div class="stack">
    {% for item in collections.featuredCommands %}
      <article class="cmd-card">
        <div>
          <a href="{{ item.url }}"><code>{{ item.data.cmdlet }}</code></a>
          <p>{{ item.data.title }}</p>
        </div>
        <div class="cmd-card-copy">
          <span class="prompt" aria-hidden="true">PS&gt;</span>
          <code>{{ item.data.command }}</code>
          <button type="button" class="btn btn-small" data-copy="{{ item.data.command | e }}">Copy</button>
        </div>
      </article>
    {% endfor %}
  </div>
  <p class="more-links"><a href="/commands/">All commands</a> <a href="/scripts/">Scripts</a> <a href="/builders/">Builders</a></p>
</section>
