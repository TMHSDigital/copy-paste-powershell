<header class="site-header">
  <div class="masthead">
    <div class="wrap masthead-inner">
      <a class="brand" href="/" aria-label="{{ site.title }} home">
        <span class="brand-mark" aria-hidden="true">PS&gt;_</span>
        <span class="brand-name"><span class="brand-copy">Copy-Paste</span> <span class="brand-ps">PowerShell</span></span>
      </a>
      <form class="header-search" role="search" action="/" method="get">
        <label class="visually-hidden" for="header-q">Search commands, scripts, and guides</label>
        <span class="prompt" aria-hidden="true">PS&gt;</span>
        <input id="header-q" name="q" type="search" placeholder="Search: ls, zip, ping..." autocomplete="off" data-search-input data-search-overlay>
      </form>
    </div>
  </div>
  <nav class="nav-bar" aria-label="Primary">
    <div class="wrap nav">
      <a href="/commands/" {% if page.url.startsWith('/commands/') %}aria-current="page"{% endif %}>Commands</a>
      <a href="/scripts/" {% if page.url.startsWith('/scripts/') %}aria-current="page"{% endif %}>Scripts</a>
      <a href="/builders/" {% if page.url.startsWith('/builders/') %}aria-current="page"{% endif %}>Builders</a>
      <a href="/guides/" {% if page.url.startsWith('/guides/') %}aria-current="page"{% endif %}>Guides</a>
      <a href="/from-bash/" {% if page.url.startsWith('/from-') %}aria-current="page"{% endif %}>From bash/cmd</a>
      <a href="/explain/" {% if page.url.startsWith('/explain/') %}aria-current="page"{% endif %}>Explain</a>
      <a href="/cheat-sheet/" {% if page.url.startsWith('/cheat-sheet/') %}aria-current="page"{% endif %}>Cheat sheet</a>
    </div>
  </nav>
</header>
