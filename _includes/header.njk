<header class="site-header">
  <div class="masthead">
    <div class="wrap masthead-inner">
      <a class="brand" href="/">
        <span class="brand-topic">PowerShell</span>
      </a>
      <form class="header-search" role="search" action="/" method="get">
        <label class="visually-hidden" for="header-q">Search</label>
        <span class="prompt" aria-hidden="true">PS&gt;</span>
        <input id="header-q" name="q" type="search" placeholder="Search" autocomplete="off" data-search-input>
      </form>
    </div>
  </div>
  <div class="series-bar">
    <div class="wrap series-inner">
      <span class="brand-series">FOR DUMMIES</span>
      <nav class="nav" aria-label="Primary">
        <a href="/commands/" {% if '/commands/' in page.url %}aria-current="page"{% endif %}>Commands</a>
        <a href="/scripts/" {% if '/scripts/' in page.url %}aria-current="page"{% endif %}>Scripts</a>
        <a href="/builders/" {% if '/builders/' in page.url %}aria-current="page"{% endif %}>Builders</a>
        <a href="/guides/" {% if '/guides/' in page.url %}aria-current="page"{% endif %}>Guides</a>
      </nav>
    </div>
  </div>
</header>
