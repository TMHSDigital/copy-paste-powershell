---
layout: base.njk
---
{% set source = page.inputPath | readSiblingPs1 %}
{% set ps1Name = page.inputPath | siblingPs1Name %}
<article class="prose">
  <p class="crumb"><a href="/scripts/">Scripts</a></p>
  <header class="page-head">
    <p class="kicker">Script</p>
    <h1>{{ title }}</h1>
    <p class="lede">{{ summary }}</p>
    <p class="meta">
      {% if difficulty %}<span class="badge">{{ difficulty }}</span>{% endif %}
      {% if topics %}
        {% for topic in topics %}
          <span class="badge badge-quiet">{{ topic }}</span>
        {% endfor %}
      {% endif %}
    </p>
  </header>

  {{ content | safe }}

  {% if parameters and parameters.length %}
    <h2>Parameters</h2>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Name</th>
            <th>Type</th>
            <th>Required</th>
            <th>Description</th>
          </tr>
        </thead>
        <tbody>
          {% for param in parameters %}
            <tr>
              <td><code>-{{ param.name }}</code></td>
              <td>{{ param.type }}</td>
              <td>{{ "Yes" if param.required else "No" }}</td>
              <td>{{ param.description }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  {% endif %}

  <h2>Source</h2>
  <div class="terminal">
    <div class="terminal-bar">
      <span class="terminal-dots" aria-hidden="true"></span>
      <span class="terminal-title">{{ ps1Name or "script.ps1" }}</span>
      <div class="terminal-actions">
        <button type="button" class="btn btn-small" data-copy-target="#script-source" data-track="script-copy" data-track-value="{{ page.fileSlug }}" aria-label="Copy the {{ ps1Name }} script">Copy</button>
        {% if ps1Name %}
          <a class="btn btn-small btn-secondary" href="{{ page.url }}{{ ps1Name }}" download>Download</a>
        {% endif %}
      </div>
    </div>
    <pre id="script-source" class="terminal-body command-pre"><code class="language-powershell">{{ source | highlightPowershell | safe }}</code></pre>
  </div>
  <p class="callout" role="note">Downloaded it? Windows blocks scripts from the internet until you unblock them: <code>Unblock-File -Path .\{{ ps1Name }}</code>. See <a href="/guides/run-a-script/">Run a script</a>.</p>

  <p class="edit-link">
    <a href="{{ site.repo }}/edit/main/{{ page.inputPath | replace('./', '') }}">Edit this page on GitHub</a>
    <span aria-hidden="true">·</span>
    <a href="{{ site.repo }}/edit/main/{{ page.inputPath | replace('./', '') | replace('index.md', ps1Name) }}">Edit {{ ps1Name }}</a>
    <span aria-hidden="true">·</span>
    <a href="{{ site.repo }}/issues/new?template=broken-snippet.yml&amp;page={{ (site.url + page.url) | urlencode }}">Report a problem</a>
  </p>
</article>
