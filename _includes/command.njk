---
layout: base.njk
---
<article class="prose">
  <p class="crumb"><a href="/commands/">Commands</a> / {{ category | categoryLabel }}</p>
  <header class="page-head">
    <p class="kicker">{{ cmdlet }}</p>
    <h1>{{ title }}</h1>
    <p class="meta">
      <span class="badge">{{ difficulty }}</span>
      <span class="badge badge-quiet">{{ category | categoryLabel }}</span>
      {% if aliases and aliases.length %}
        <span class="aliases">Aliases {% for alias in aliases %}<code>{{ alias }}</code>{% endfor %}</span>
      {% endif %}
    </p>
  </header>

  <div class="terminal">
    <div class="terminal-bar">
      <span class="terminal-dots" aria-hidden="true"></span>
      <span class="terminal-title">{{ cmdlet }}</span>
      <button type="button" class="btn btn-small" data-copy="{{ command | e }}">Copy</button>
    </div>
    <pre class="terminal-body command-pre"><span class="prompt">PS&gt;</span> <code class="language-powershell">{{ command }}</code></pre>
  </div>

  {% if warning %}
    <p class="callout callout-warn" role="note">{{ warning }}</p>
  {% endif %}

  {{ content | safe }}

  {% set related = collections.commands | relatedCommands(page.url, topics) %}
  {% if related.length %}
    <h2>Related commands</h2>
    <ul class="related-list">
      {% for item in related %}
        <li><a href="{{ item.url }}"><code>{{ item.data.cmdlet }}</code> {{ item.data.title }}</a></li>
      {% endfor %}
    </ul>
  {% endif %}
</article>
