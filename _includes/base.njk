<!DOCTYPE html>
<html lang="en" data-base="{{ '/' | url }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title and title != site.title %}{{ title }} | {{ site.title }}{% else %}{{ site.title }}{% endif %}</title>
  <meta name="description" content="{{ description or summary or site.description }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/assets/vendor/prism.css">
  <link rel="stylesheet" href="/assets/css/site.css">
</head>
<body class="{% if page.url == '/' %}page-home{% endif %}">
  <a class="skip-link" href="#main">Skip to content</a>
  {% include "header.njk" %}
  <main id="main">
    {{ content | safe }}
  </main>
  {% include "footer.njk" %}
  <script src="/assets/js/copy.js" defer></script>
  <script src="/assets/js/search.js" defer></script>
  <script src="/assets/js/builder.js" defer></script>
</body>
</html>
