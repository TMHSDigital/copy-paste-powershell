---
layout: base.njk
---
<article class="prose">
  <p class="crumb"><a href="/builders/">Builders</a></p>
  <header class="page-head">
    <p class="kicker">Builder</p>
    <h1>{{ title }}</h1>
    <p class="lede">{{ summary }}</p>
  </header>

  {{ content | safe }}

  <p id="builder-shared-note" class="callout" role="note" hidden>This form was filled in from a shared link. Read the script before you run it.</p>

  <div class="builder-layout">
    <form id="builder-form" class="builder-form" novalidate>
      {% for field in fields %}
        <div class="field">
          {% if field.type == "checkbox" %}
            <label class="check-label">
              <input type="checkbox" name="{{ field.name }}" {% if field.default %}checked{% endif %} aria-describedby="error-{{ field.name }}{% if field.help %} help-{{ field.name }}{% endif %}">
              {{ field.label }}
            </label>
          {% elif field.type == "select" %}
            <label for="field-{{ field.name }}">{{ field.label }}</label>
            <select id="field-{{ field.name }}" name="{{ field.name }}" aria-describedby="error-{{ field.name }}{% if field.help %} help-{{ field.name }}{% endif %}">
              {% for option in field.options %}
                <option value="{{ option.value }}" {% if option.value == field.default %}selected{% endif %}>{{ option.label }}</option>
              {% endfor %}
            </select>
          {% else %}
            <label for="field-{{ field.name }}">{{ field.label }}{% if field.required %} <span class="required">(required)</span>{% endif %}</label>
            <input
              id="field-{{ field.name }}"
              type="{% if field.type == 'number' %}text{% else %}{{ field.type or 'text' }}{% endif %}"
              {% if field.type == "number" %}inputmode="numeric"{% endif %}
              name="{{ field.name }}"
              value="{{ field.default | orEmpty }}"
              placeholder="{{ field.placeholder or '' }}"
              spellcheck="false"
              autocomplete="off"
              aria-describedby="error-{{ field.name }}{% if field.help %} help-{{ field.name }}{% endif %}"
            >
          {% endif %}
          {% if field.help %}
            <p class="field-help" id="help-{{ field.name }}">{{ field.help }}</p>
          {% endif %}
          {#- Not role="alert": it would interrupt on every keystroke. The field
              gets aria-invalid, and its error is read through aria-describedby. #}
          <p class="field-error" id="error-{{ field.name }}" hidden></p>
        </div>
      {% endfor %}
    </form>

    <div>
      <h2 class="preview-label">Preview</h2>
      <div class="terminal">
        <div class="terminal-bar">
          <span class="terminal-dots" aria-hidden="true"></span>
          <span class="terminal-title">{{ page.fileSlug }}.ps1</span>
          <div class="terminal-actions">
            <button type="button" class="btn btn-small" data-copy-target="#builder-preview" data-track="builder-copy" aria-label="Copy generated script">Copy</button>
            <button type="button" class="btn btn-small btn-secondary" id="builder-download">Download</button>
            <button type="button" class="btn btn-small btn-secondary" id="builder-share" data-copy="" aria-label="Copy a link to this filled-in form">Copy link</button>
          </div>
        </div>
        <pre id="builder-preview" class="terminal-body command-pre" tabindex="0" role="region" aria-label="Generated script" data-always-focusable><code class="language-powershell"></code></pre>
      </div>
      <div class="builder-explain" hidden>
        <h2 class="preview-label">What it does</h2>
        <ul id="builder-explain"></ul>
      </div>
    </div>
  </div>

  {% include "edit-link.njk" %}

  <script type="application/json" id="builder-spec">{{ { fields: fields, template: template, filename: page.fileSlug + ".ps1" } | json | safe }}</script>
</article>
